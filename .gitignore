# binaries
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
# built binary only; a bare "server" rule also ignores cmd/server/
/server

# test / coverage
*.test
*.out
coverage.*

# tooling
.idea/
.vscode/
*.swp
.DS_Store

# local runtime data (SQLite DB, server private keys, build assets)
/data/

# local config overrides
configs/config.local.yaml
.env

# superpowers ledgers: process artifacts (rulings, review notes, evidence)
# stay in the local workspace only, never in the repository.
.superpowers/

# one-off maintenance scripts
.tmp_*

# git worktrees (superpowers using-git-worktrees)
/.worktrees/
